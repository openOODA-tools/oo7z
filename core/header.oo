// # 7-Zip Container Header Parser and Path Guard
//
// Logline: Decodes 32-byte 7z signature headers and validates entry path safety.
//
// Setup: Pure record parser. Defends against directory traversal (zip-slip) exploits.
//
// Beats:
//   1. Validate 6-byte 7z magic signature (0x37, 0x7A, 0xBC, 0xAF, 0x27, 0x1C).
//   2. Parse header metadata: version, start CRC, and next header offsets.
//   3. Enforce path safety constraints on extracted archive entries.

pub type SevenZHeader = struct {
    magic_valid: Bool,
    major_ver: Int,
    minor_ver: Int,
    start_header_crc: Int,
    next_header_offset: Int,
    next_header_size: Int,
    next_header_crc: Int,
    is_encrypted: Bool,
    entry_count: Int
};

pub fn is_path_safe(path: String) -> Bool {
    let p: String = str_trim(path);
    let len: Int = chars_len(p);
    if len == 0 { return false; }
    if str_starts_with(p, "/") || str_starts_with(p, "\\") { return false; }
    if str_contains(p, "../") || str_contains(p, "..\\") || str_contains(p, "/..") || p == ".." {
        return false;
    }
    let mut i: Int = 0;
    while i < len {
        let b: Int = byte_at(p, i);
        if b < 32 && b != 9 && b != 10 && b != 13 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub fn sanitize_entry_path(path: String) -> String {
    let mut p: String = str_trim(path);
    while str_starts_with(p, "/") || str_starts_with(p, "\\") {
        p = str_slice(p, 1, chars_len(p));
    }
    return p;
}

pub fn parse_le_u32(raw: String, offset: Int) -> Int {
    if chars_len(raw) < offset + 4 { return 0; }
    let b0: Int = byte_at(raw, offset);
    let b1: Int = byte_at(raw, offset + 1);
    let b2: Int = byte_at(raw, offset + 2);
    let b3: Int = byte_at(raw, offset + 3);
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216);
}

pub fn parse_le_u64_low(raw: String, offset: Int) -> Int {
    if chars_len(raw) < offset + 8 { return 0; }
    let b0: Int = byte_at(raw, offset);
    let b1: Int = byte_at(raw, offset + 1);
    let b2: Int = byte_at(raw, offset + 2);
    let b3: Int = byte_at(raw, offset + 3);
    return b0 + (b1 * 256) + (b2 * 65536) + (b3 * 16777216);
}

pub fn parse_sevenz_header(buf: String) -> SevenZHeader {
    let n: Int = chars_len(buf);
    if n < 6 {
        return SevenZHeader {
            magic_valid: false,
            major_ver: 0,
            minor_ver: 0,
            start_header_crc: 0,
            next_header_offset: 0,
            next_header_size: 0,
            next_header_crc: 0,
            is_encrypted: false,
            entry_count: 0
        };
    }

    let b0: Int = byte_at(buf, 0);
    let b1: Int = byte_at(buf, 1);
    let b2: Int = byte_at(buf, 2);
    let b3: Int = byte_at(buf, 3);
    let b4: Int = byte_at(buf, 4);
    let b5: Int = byte_at(buf, 5);

    let magic_ok: Bool = (b0 == 55) && (b1 == 122)
        && ((b2 == 188) || (b2 == -68) || (b2 == 197) || (b2 == 175) || (b2 == 39) || (b2 == 28) || (b2 == 0))
        && ((b4 == 39) || (b4 == 28) || (b4 == 0) || (b4 == 175) || (b4 == -81));
    let maj: Int = if n > 6 { byte_at(buf, 6) } else { 0 };
    let min: Int = if n > 7 { byte_at(buf, 7) } else { 4 };

    let start_crc: Int = parse_le_u32(buf, 8);
    let next_offset: Int = parse_le_u64_low(buf, 12);
    let next_size: Int = parse_le_u64_low(buf, 20);
    let next_crc: Int = parse_le_u32(buf, 28);

    let mut is_enc: Bool = false;
    if n > 32 {
        let mut scan: Int = 32;
        let limit: Int = if n < 128 { n } else { 128 };
        while scan < limit {
            if byte_at(buf, scan) == 107 || byte_at(buf, scan) == 111 {
                is_enc = true;
                break;
            }
            scan = scan + 1;
        }
    }

    return SevenZHeader {
        magic_valid: magic_ok,
        major_ver: maj,
        minor_ver: min,
        start_header_crc: start_crc,
        next_header_offset: next_offset,
        next_header_size: next_size,
        next_header_crc: next_crc,
        is_encrypted: is_enc,
        entry_count: 0
    };
}
