// # MCP Stdio Server - 7-Zip Container Inspector and Path Guard
//
// Logline: Speaks Model Context Protocol over stdio for LLM coding agents.
//
// Setup: Requires FsReadCap. Dispatches oo7z_inspect, oo7z_test, and oo7z_verify_path tools.
//
// Beats:
//   1. Handle initialize and notifications/initialized lifecycle handshakes.
//   2. Advertise oo7z_inspect, oo7z_test, and oo7z_verify_path tools with JSON schemas.
//   3. Dispatch tools/call requests and return structured responses.

import "core/header.oo";
import "core/archive.oo";
import "ipc/json_field.oo";

fn build_error(id: String, code: Int, msg: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"error\":{\"code\":" + to_string(code) + ",\"message\":\"" + json_escape(msg) + "\"}}";
}

fn build_tool_result(id: String, text: String) -> String {
    return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"content\":[{\"type\":\"text\",\"text\":\"" + json_escape(text) + "\"}]}}";
}

fn handle_tool_call(fs: &FsReadCap, id: String, req: String) -> String {
    let params: String = json_field_raw(req, "params");
    let tool_name: String = json_field_string(params, "name");
    let args: String = json_field_raw(params, "arguments");

    if tool_name == "oo7z_inspect" {
        let path: String = json_field_string(args, "archive_path");
        let r: Result[String, String] = read_file(fs, path);
        if r.is_err() {
            return build_error(id, -32000, "cannot read archive: " + path);
        }
        let content: String = match r { Ok(s) => s, Err(_) => "" };
        let info: String = summarize_archive_info(content, path);
        return build_tool_result(id, info);
    }

    if tool_name == "oo7z_test" {
        let path: String = json_field_string(args, "archive_path");
        let r: Result[String, String] = read_file(fs, path);
        if r.is_err() {
            return build_error(id, -32000, "cannot read archive: " + path);
        }
        let content: String = match r { Ok(s) => s, Err(_) => "" };
        let status: String = inspect_test_integrity(content);
        return build_tool_result(id, status);
    }

    if tool_name == "oo7z_verify_path" {
        let test_path: String = json_field_string(args, "path");
        let safe: Bool = is_path_safe(test_path);
        let out: String = "{\"path\":\"" + test_path + "\",\"is_safe\":" + (if safe { "true" } else { "false" }) + "}";
        return build_tool_result(id, out);
    }

    return build_error(id, -32601, "unknown tool: " + tool_name);
}

fn handle_mcp_request(fs: &FsReadCap, req: String) -> String {
    let method: String = json_field_string(req, "method");
    let raw_id: String = json_field_raw(req, "id");
    let id: String = if chars_len(raw_id) == 0 { "null" } else { raw_id };

    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"protocolVersion\":\"2024-11-05\",\"capabilities\":{\"tools\":{}},\"serverInfo\":{\"name\":\"oo7z\",\"version\":\"0.2.0\"}}}";
    }
    if method == "notifications/initialized" {
        return "";
    }
    if method == "tools/list" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":{\"tools\":[{\"name\":\"oo7z_inspect\",\"description\":\"Inspect 7-Zip archive container properties and headers\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"archive_path\":{\"type\":\"string\"}},\"required\":[\"archive_path\"]}},{\"name\":\"oo7z_test\",\"description\":\"Test 7-Zip archive integrity and container signature\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"archive_path\":{\"type\":\"string\"}},\"required\":[\"archive_path\"]}},{\"name\":\"oo7z_verify_path\",\"description\":\"Validate file path against directory traversal zip-slip\",\"inputSchema\":{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\"}},\"required\":[\"path\"]}}]}}";
    }
    if method == "tools/call" {
        return handle_tool_call(fs, id, req);
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + id + ",\"result\":null}";
    }
    return build_error(id, -32601, "method not found: " + method);
}

pub fn run_mcp_server(fs: &FsReadCap) -> Int {
    let mut buf: String = "";
    let mut running: Bool = true;
    while running {
        let mut nl: Int = str_index_of(buf, "\n");
        while nl >= 0 {
            let line: String = str_trim(str_slice(buf, 0, nl));
            buf = str_slice(buf, nl + 1, chars_len(buf));
            if chars_len(line) > 0 {
                let resp: String = handle_mcp_request(fs, line);
                if chars_len(resp) > 0 {
                    println(resp);
                }
            }
            nl = str_index_of(buf, "\n");
        }

        let cr: Result[String, String] = oo_read_stdin_chunk(fs, 100);
        if !cr.is_ok() {
            running = false;
        } else {
            let chunk: String = match cr { Ok(s) => s, Err(_) => "" };
            if chars_len(chunk) == 0 {
                running = false;
            } else {
                buf = buf + chunk;
            }
        }
    }
    return 0;
}
